{
  "name": "regain-pc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Regain for PC \u2014 focus timer, app/website blocker, screen-time analytics, study rooms and Reels/Shorts blocking.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "test": "node tests/run.mjs",
    "test:engine": "node tests/engine.test.mjs",
    "test:relay": "node tests/relay.test.mjs",
    "relay": "node server/room-server.mjs",
    "test:extension": "node tests/extension.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
